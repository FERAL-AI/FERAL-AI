{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FERAL",
  "version": "2026.9.7",
  "identifier": "ai.feral.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "bash ../scripts/build_webui_v2.sh && npm run build && npm run stage:bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FERAL",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": true,
        "transparent": false
      },
      {
        "label": "floating",
        "title": "FERAL",
        "url": "floating-window.html",
        "width": 400,
        "height": 600,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true,
        "transparent": true,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "feral-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "showMenuOnLeftClick": false,
      "tooltip": "FERAL"
    },
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ws://localhost:* http://localhost:* ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:*; media-src 'self' blob:; font-src 'self' data:; frame-src 'self' http://localhost:* http://127.0.0.1:*",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/feral-core": "feral-core",
      "resources/python": "python",
      "resources/opencode": "opencode"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "FERAL \u2014 Local-First AI Agent",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": false
  }
}
