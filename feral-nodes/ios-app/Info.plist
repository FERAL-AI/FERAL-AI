<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>FERAL Node</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!--
        CFBundleShortVersionString tracks the FERAL CalVer source of
        truth at feral-core/pyproject.toml [project].version.
        scripts/sync_versions.py rewrites this literal on every
        release bump; do not edit by hand. The matching About row
        in SettingsView reads this key at runtime so the operator
        sees the same version the brain advertises.
    -->
    <key>CFBundleShortVersionString</key>
    <string>2026.5.44</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <!--
            audio: keep voice capture / playback alive when the
            screen locks during a voice turn.
            bluetooth-central: BLEPeripheralScanner continues to
            receive `didDiscoverPeripheral` callbacks for the
            subset of devices iOS allows in background (filtered
            by service UUID per Apple's BLE background rules).
            Generic-discovery scans run only when the app is
            foreground; this background mode keeps the connection
            to FERAL glasses alive when the user pockets the phone.
        -->
        <string>audio</string>
        <string>bluetooth-central</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSCameraUsageDescription</key>
    <string>FERAL Node uses the camera to scan QR codes for pairing and to capture frames for the Brain's perception pipeline.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>FERAL Node uses the microphone for voice commands sent to the Brain.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>FERAL Node shares location with the Brain for context-aware assistance.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>FERAL Node shares location with the Brain for continuous context-aware assistance.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>FERAL Node uses Bluetooth to connect to FERAL Glasses for sensor data and to discover nearby peripherals (AirPods, Apple Watch, heart-rate monitors, scales, etc.) so the Brain can answer "what's near me?" queries.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>FERAL Node reads health data to forward to the Brain for health monitoring.</string>
    <!--
        feral:// URL scheme. Pair pages on the brain emit a
        feral://pair?p=<base64url-encoded-json-payload> link as an
        alternative to the QR for desktops that share a deep link by
        text message. This handler routes the URL into the same QR
        decoder so behavior is identical.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>ai.feral.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>feral</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
        </dict>
    </array>
</dict>
</plist>
